# Create a .gitignore file if it doesn't exist
echo ".vscode/" >> .gitignore
echo "*.log" >> .gitignore
echo "__pycache__/" >> .gitignore
echo "*.pyc" >> .gitignore

# Remove already staged .vscode (if any)
git rm -r --cached .vscode
