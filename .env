# .env — AI-EVER
# Copy this file to .env in the project root and update the placeholder values.
# Values here are examples — do NOT commit secrets to version control.

# Web server / Flask
PORT=5000
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=replace_with_a_random_secret_key

# Database configuration (optional)
# The app can use an on-disk SQLite DB by default (see sql/ConnDB.py).
# If you want to use MySQL for extraction/storage, fill these and use the Extract UI.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=ai_ever_db

# If you prefer sqlite, point to the DB file (default used by sql/ConnDB.py):
SQLITE_DB_PATH=sql/DB/AI_EVER_DB.db

# Model / Hugging Face
# Path where local models/checkpoints live
MODEL_BASE_PATH=/home/xon/Desktop/AI-EVER/LLMModels
# Optional Hugging Face token if you download models programmatically
HF_TOKEN=your_hf_token_here

# Cache / performance
TRANSFORMERS_CACHE=${HOME}/.cache/huggingface/transformers
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Logging
LOG_DIR=log

# Notes:
# - Replace placeholders (passwords, tokens, SECRET_KEY) with real values locally.
# - Don't commit this file to git. Add .env to .gitignore if not already present.
# - To load these into your shell:
#     set -a; source .env; set +a
# - To run the app after activation and loading env:
#     python run.py

BASE_URL=http://localhost:5000
