                'polydipsia' => $data['polydipsia'],
                'smoking' => $data['smoking'],
                'myocardial_infarction' => $data['myocardial_infarction'],
                'drug_recommendation' => $data['drug_recommendation'],
                'high_bmi' => $data['high_bmi'],
                'physical_activity' => $data['physical_activity'],
                'tobacco' => $data['tobacco'],
                'alcohol' => $data['alcohol'],
                'height' => $data['height'],
                'added_by' => $data['added_by'],
                'added_on' => $data['added_on']
            ]);

        $oResult = $oQueryBuilder->execute();
        return $conn->lastInsertId();
    } catch (Exception $e) {
        $oLogger = Logger::getInstance();
        $oLogger->error('SQL Error', [$e->getMessage()]);
        return false;
    }
}


function getCdssData($iPatientId)
{
    $oContainerService = ContainerService::getInstance();
    $conn =  $oContainerService->get("db");
    $oQueryBuilder = $conn->createQueryBuilder();
    $aData = array();
    try {
        $oQueryBuilder
            ->select('*')
            ->from('mxcel_cdss_field_value')
            ->where('patient_id = :patient_id')
            ->setParameter('patient_id', $iPatientId);

        $oResult = $oQueryBuilder->execute();
        if ($oResult !== FALSE) {
            while ($aRow = $oResult->fetchAssociative()) {
                $aData = $aRow;
            }
        }
    } catch (Exception $e) {
        $oLogger = Logger::getInstance();
        $oLogger->error('SQL Error', [$e->getMessage()]);
        return false;
    }
    return $aData;
}


function invalidCdss($iPatientId)
{
    $oContainerService = ContainerService::getInstance();
    $conn =  $oContainerService->get("db");
    $oQueryBuilder = $conn->createQueryBuilder();

    try {
        $oQueryBuilder
            ->update('mxcel_cdss_field_value')
            ->set('deleted', 1)
            ->where('patient_id = :patient_id')
            ->setParameter('patient_id', $iPatientId)
            ->execute();

        $oResult = $oQueryBuilder->execute();
        if($oResult){
            return true;
        }
    } catch (Exception $e) {
        $oLogger = Logger::getInstance();
        $oLogger->error('SQL Error', [$e->getMessage()]);
        return false;
    }
}

