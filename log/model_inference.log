    $oContainerService = ContainerService::getInstance();
    $conn =  $oContainerService->get("db");
    $oQueryBuilder = $conn->createQueryBuilder();
    $sParameterVal = DATABASE_TABLE_PREFIX . '_pathology_parameter_collected_values';
    $aLatestParametersVal = [];

    $oQueryBuilder
        ->select("A.*")
        ->from($sParameterVal, 'A')
        ->innerjoin('A', "(SELECT MAX(id) AS id, field_value, parameter_id, consultation_id ,patient_id
                    FROM mxcel_pathology_parameter_collected_values AS t WHERE field_value IS NOT NULL
                    AND field_value != ''GROUP BY consultation_id)", 'B', ' A.patient_id = B.patient_id')
        ->where('B.patient_id = :patient_id')
        ->andWhere('B.consultation_id = :consultation_id')
        ->setParameter('patient_id', $iPatientID)
        ->setParameter('consultation_id', $iConsultationID);

    try {

        $oResult = $oQueryBuilder->execute();
        if ($oResult !== FALSE) {
            while ($aRow = $oResult->fetchAssociative()) {
                $aLatestParametersVal[] = $aRow;
            }
        }
    } catch (Exception $e) {
        $oLogger = Logger::getInstance();
        $oLogger->error('SQL Error', [$e->getMessage()]);
    }

    return $aLatestParametersVal;
}


