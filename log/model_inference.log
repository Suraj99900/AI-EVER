function fGetUserSubTypeDetailsByStaffID($iUserID = null) {
        $aUsers = array();
        $sUserProfileTable = DATABASE_TABLE_PREFIX."_user_profiles";
        $sUserSubType = DATABASE_TABLE_PREFIX."_user_sub_type";

        $sSQuery = "SELECT * FROM `{$sUserProfileTable}` AS a LEFT JOIN `{$sUserSubType}` as b on a.`user_subtype_id` = b.`user_subtype_id` WHERE `staff_id` = ? AND b.`status` = 1 ";
    
        $DBMan = new DBConnManager();
        $conn =  $DBMan->getConnInstance();
        
        $oPreparedStatement = $conn->prepare($sSQuery);

        if (!$oPreparedStatement) {
            return $aUsers;
        }

        if(!$oPreparedStatement->bind_param("i", $iUserID)) {
            return $aUsers;
        }
        if (!$oPreparedStatement->execute()) {
            return $aUsers;
        }

        $sResult = $oPreparedStatement->get_result();

        if ($sResult!==FALSE) {
            $aRow = $sResult->fetch_assoc();
            if(!empty($aRow)){
                $aUsers = $aRow;         
            }
        }
        return $aUsers;
    }
