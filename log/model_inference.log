def parse_pubmed_xml(xml_data: str, debug: bool = False) -> List[Dict[str, Optional[str]]]:
    """
    Parse PubMed XML data and extract relevant fields.

    Args:
        xml_data (str): XML data returned by PubMed EFetch.
        debug (bool): Print debug information.

    Returns:
        List[Dict[str, Optional[str]]]: List of dictionaries containing paper details.
    """
    from xml.etree import ElementTree as ET

    papers = []
    root = ET.fromstring(xml_data)

    for article in root.findall(".//PubmedArticle"):
        paper = {
            "PubmedID": None,
            "Title": None,
            "Publication_Date": None,
            "Non_academic_Authors": None,
            "Company_Affiliations": None,
            "Corresponding_Author_Email": None,
        }

        # Extract Pubmed ID
        pmid_elem = article.find(".//PMID")
        if pmid_elem is not None:
            paper["PubmedID"] = pmid_elem.text

        # Extract Title
        title_elem = article.find(".//ArticleTitle")
        if title_elem is not None:
            paper["Title"] = title_elem.text

        # Extract Publication Date
        pub_date_elem = article.find(".//PubDate")
        if pub_date_elem is not None:
            paper["Publication_Date"] = " ".join(pub_date_elem.itertext())

        # Extract Authors and Affiliations
        authors = []
        affiliations = []
        for author in article.findall(".//Author"):
            affiliation = author.find(".//AffiliationInfo/Affiliation")
            if affiliation is not None:
                affiliations.append(affiliation.text)

                # Detect non-academic affiliations
                if any(company_keyword in affiliation.text.lower() for company_keyword in ["pharma", "biotech", "company"]):
                    authors.append(author.find("LastName").text if author.find("LastName") else "Unknown")

        paper["Non_academic_Authors"] = ", ".join(authors)
        paper["Company_Affiliations"]  "complete this function properly "
