<?php

class CSRFGuard {
    const SESSION_KEY = "_csrfToken";
    const INPUT_NAME = "_csrf_token";

    public static function generateToken() : string{
        return bin2hex(random_bytes(32));
    }

    public static function getSessionKey() : string {
        return CSRFGuard::SESSION_KEY;
    }

    public static function getFormInputName() : string {
        return CSRFGuard::INPUT_NAME;
    }

    public static function putFormInput(SessionManager $oSession) {
        echo "<input type='hidden' name='".self::getFormInputName()."' value='".$oSession->fGetSessionVariable(self::getSessionKey())."' />";
    }

    public static function getToken(SessionManager $oSession){
        return $oSession->fGetSessionVariable(self::getSessionKey());
    }

    public static function validateToken(array $aRequest, SessionManager $oSession) : bool {
        if(!isset($aRequest[CSRFGuard::INPUT_NAME]) || !$oSession->fGetSessionVariable(self::getSessionKey())){
            return false;
        }

        if($aRequest[CSRFGuard::INPUT_NAME] != $oSession->fGetSessionVariable(self::getSessionKey())){
            return false;
        }

        return true;
    }

    public static function guard(SessionManager $oSession){
        if(!self::validateToken($_REQUEST,$oSession)){
            throw new \InvalidCSRFTokenException("Invalid CSRF token");
        }
    }
}  refactor this code
