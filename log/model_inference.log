function getODBalance($iODID) {
    $oContainerService = ContainerService::getInstance();
    $conn = $oContainerService->get("db");
    $oQueryBuilder = $conn->createQueryBuilder();
    $iBalance = 0;
    $sTable = DATABASE_TABLE_PREFIX.'_od_billing_ledger';

    $sSQuery = "SELECT SUM(CASE entry_type = 0 THEN amount*-1 ELSE amount) FROM {$sTable} WHERE od_id={$iODID} AND deleted=0";

    $oQueryBuilder
        ->select('SUM(CASE entry_type = 0 THEN amount*-1 ELSE amount)')
        ->from($sTable)
        ->where('deleted = 0')
        ->andWhere('od_id = :od_id')
        ->setParameter('od_id', $iODID)
        ;

    try {
        $oResults = $oQueryBuilder->execute();
        if($oResults !== false){
            while($aRow = $oResults->fetchAssociative()){
                $iBalance = $aRow[0];
            }
        }
    } catch (Exception $e) {
        $oLogger = Logger::getInstance();
        $oLogger->error('SQL Error',[$e]);
    }

    return $iBalance;
}   modify this function to add the filetr there for condition wise to add in the query builder
