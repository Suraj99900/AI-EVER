2025-09-28 14:08:08,118 - INFO - Received streaming prompt: ### Instruction:
def search_pubmed(query: str, max_results: int = 100, debug: bool = False) -> List[str]:
    """
    Search PubMed and retrieve PMIDs matching the query.

    Args:
        query (str): PubMed query string.
        max_results (int): Maximum number of results to fetch.
        debug (bool): Print debug information.

    Returns:
        List[str]: List of PMIDs.
    """
    url = f"{BASE_URL}/esearch.fcgi"
    params = {
        "db": "pubmed",
        "term": query,
        "retmax": max_results,
        "retmode": "json",
        "usehistory": "y",
    }
    if debug:
        print(f"Querying PubMed ESearch: {url} with params {params}")

    response = requests.get(url, params=params)
    response.raise_for_status()
    data = response.json()

    if debug:
        print(f"ESearch Response: {data}")

    return data.get("esearchresult", {}).get("idlist", [])
