    `patient_id`,`admit_id`,`schedule_id`,`consultation_id`,`is_ipd`,`ultrasound`,`pa`,`tenderness`,`flatus_passed`,`stool_passed`,`stool_frequency`,`stool_frequency_val`,`stool_consistency`,`stool_color`,`bowel_sound`,`ryles_tube`,`wound`,`drains_number`,`drains_output`,`enteral`,`enteral_rate`,`calories_req`,`calories_rec`,`proteins_req`,`proteins_rec`,`added_on`,`added_by`,`deleted`,`stool_color_other`,`wound_other`) VALUES ('{$iPatientID}','{$iAdmitID}','{$iScheduleID}','{$iConsultationID}','{$iIsIpd}','{$idGIUltrasound}','{$idGIPA}','{$idGITenderness}','{$idGIFlatusPassed}','{$idGIStoolPassed}','{$idGIStoolFrequency}','{$idGIStoolFrequencyVal}','{$idGIStoolConsistency}','{$idGIStoolColor}','{$idGIBowel}','{$idGIRylesTube}','{$idGIWound}','{$idGIDrainsNumber}','{$idGIDrainOutput}','{$idGIEnteral}','{$idGIEnteralRate}','{$idGICaloriesRequirement}','{$idGICaloriesReceived}','{$idGIProteinsRequirement}','{$idGIProteinsReceived}',CURRENT_TIMESTAMP,'{$iUserID}',0,'{$idGIStoolColorOther}','{$idGIWoundOther}')";
    
    if($conn != false){
        $sQueryR = $conn->query($sQuery);
        if($sQueryR > 0){
            $iInsertId = $conn->insert_id;
        }
        $DBMan = NULL;
    }
    return $iInsertId;
}

/*function to get GI details by admit id
  Added by Akshay Sutar on 29-11-2017  
*/
function getGIDetailsByAdmitId($iAdmitId){

    $DBMan = new DBConnManager();
    $conn =  $DBMan->getConnInstance();
    $sTable = 'mxcel_helper_gi';

    $sQuery = "SELECT * FROM `{$sTable}` WHERE `admit_id`='{$iAdmitId}' AND `deleted` = 0 AND `is_ipd`=1 ORDER BY `added_on` DESC";
    $rResult = $conn->query($sQuery);

    $aData = array();
    if($rResult != false){
        while($row = $rResult->fetch_array())
        {
            $aData[] = $row;
        }
    }
    return($aData);
}

