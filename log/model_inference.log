		//! Brief function to get area  names by city
		function GetAllAreaListByCity()
	    {
	    	var sCity = $('#idCityName').val();
            $.ajax
            ({
                url: "ajaxVanManagement.php?sFlag=getAllAreaNamesForCity",
                data:{sCity:sCity},
                success: function (data)
                {
                   if(data != '')
                   {
                   		var obj = JSON.parse(data);
                        $.each(obj,function(index,sAreaName)
                        {
                        	$('.classAreaName').append($("<option></option>").attr("value",sAreaName['id']).text(sAreaName['area']));
                        })
                    }
                }
            });
           $('#vanLoginModal').modal('show');
	    }

	    // function to get Mumbai city details
	    function getCityList()
	    {
            $.ajax
            ({
                url: "ajaxVanManagement.php?sFlag=getCityList",
                success: function (data)
                {
                   if(data != '')
                    {
                   		var obj = JSON.parse(data);
                        	$('.classCityName').append($("<option selected></option>").attr("value",obj['city']).text(obj['city'])).trigger("change");
                    }
                }
            });

	    }

