        ->innerjoin('A', "(SELECT MAX(id) AS id, field_value, parameter_id, consultation_id ,patient_id
                    FROM mxcel_pathology_parameter_collected_values AS t WHERE field_value IS NOT NULL
                    AND field_value != ''GROUP BY consultation_id)", 'B', ' A.patient_id = B.patient_id')
        ->where('B.patient_id = :patient_id')
