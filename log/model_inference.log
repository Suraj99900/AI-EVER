include_once "config/configEhr.php";
include_once ABS_PATH_TO_EHR . "classes/class.DBConnManager.php";
include_once ABS_PATH_TO_EHR . "classes/class.SessionManager.php";



function fGetPatientLatestvitalData($iPatientID, $iConsultationID)
{
    $oContainerService = ContainerService::getInstance();
    $conn =  $oContainerService->get("db");
    $oQueryBuilder = $conn->createQueryBuilder();
    $sVitalDetails = DATABASE_TABLE_PREFIX . '_helper_vital_details';
    $sVitalMaster = DATABASE_TABLE_PREFIX . '_vital_master';
    $aLatestVitals = [];

    $oQueryBuilder
        ->select("*")
        ->from($sVitalDetails, 'A')
        ->innerjoin('A', "(SELECT MAX(set_id) AS set_id,patient_id,consultation_id
                FROM mxcel_helper_vital_details AS t
                WHERE field_value IS NOT NULL
                AND field_value != ''
                GROUP BY consultation_id)", 'B', ' A.patient_id = B.patient_id 
                AND A.set_id = B.set_id')
        ->leftJoin('A', $sVitalMaster, 'C', 'C.vital_id = A.vital_id')
        ->where('B.patient_id = :patient_id')
        ->andWhere('B.consultation_id = :consultation_id')
        ->setParameter('patient_id', $iPatientID)
        ->setParameter('consultation_id', $iConsultationID);

    try {

        $oResult = $oQueryBuilder->execute();
        if ($oResult !== FALSE) {
            while ($aRow = $oResult->fetchAssociative()) {
                $aLatestVitals[] = $aRow;
            }
        }
    } catch (Exception $e) {
        $oLogger = Logger::getInstance();
        $oLogger->error('SQL Error', [$e->getMessage()]);
    }

    return $aLatestVitals;
}


